{
  "expo": {
    "name": "Yazgı",
    "slug": "yazgi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "projectRoot": "./",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableHermes": true,
            "newArchEnabled": true
          },
          "ios": {
            "useFrameworks": "static",
            "enableHermes": true,
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-firebase/app"
    ],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yazgi.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.yazgi.app",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "c4188d07-e11e-43ce-a21d-5f620933c449"
      }
    }
  }
}
