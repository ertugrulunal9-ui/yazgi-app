{
  "expo": {
    "name": "Yazgı",
    "slug": "yazgi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "enableHermes": true,
            "newArchEnabled": true
          },
          "ios": {
            "useFrameworks": "static",
            "enableHermes": true,
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7452780443706539~6798586178",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "@react-native-firebase/crashlytics",
      "expo-localization"
    ],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yazgi.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.yazgi.app",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "_admob_note": "LAUNCH CHECKLIST: Replace test app IDs in plugins.react-native-google-mobile-ads AND fill ad unit IDs below with production values from AdMob console (admob.google.com)",
      "admob": {
        "androidRewardedUnitId": "ca-app-pub-7452780443706539/8447534175",
        "iosRewardedUnitId": "TODO_REPLACE_WITH_ADMOB_IOS_REWARDED_UNIT_ID",
        "androidInterstitialUnitId": "ca-app-pub-7452780443706539/7601150500",
        "iosInterstitialUnitId": "TODO_REPLACE_WITH_ADMOB_IOS_INTERSTITIAL_UNIT_ID"
      },
      "monetization": {
        "interstitialSessionLimit": 2,
        "interstitialCooldownMs": 180000
      },
      "revenueCat": {
        "iosApiKey": "TODO_REPLACE_WITH_REVENUECAT_IOS_API_KEY",
        "androidApiKey": "goog_VKJbyVvVAJNrTCYOOHKPkFUaeii"
      },
      "premiumRollout": {
        "_note": "Kill-switch and operation gates for dark-launch control",
        "killSwitch": false,
        "purchasesEnabled": true,
        "restoreEnabled": true
      },
      "cloudSync": {
        "enabled": false
      },
      "eas": {
        "projectId": "c4188d07-e11e-43ce-a21d-5f620933c449"
      }
    }
  }
}
