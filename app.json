{
  "expo": {
    "name": "Yazgı",
    "slug": "yazgi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableHermes": true,
            "newArchEnabled": true
          },
          "ios": {
            "useFrameworks": "static",
            "enableHermes": true,
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "@react-native-firebase/crashlytics",
      "expo-localization"
    ],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yazgi.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.yazgi.app",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "_admob_note": "LAUNCH CHECKLIST: Replace test app IDs in plugins.react-native-google-mobile-ads AND fill ad unit IDs below with production values from AdMob console (admob.google.com)",
      "admob": {
        "androidRewardedUnitId": "TODO_REPLACE_WITH_ADMOB_ANDROID_REWARDED_UNIT_ID",
        "iosRewardedUnitId": "TODO_REPLACE_WITH_ADMOB_IOS_REWARDED_UNIT_ID",
        "androidInterstitialUnitId": "TODO_REPLACE_WITH_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID",
        "iosInterstitialUnitId": "TODO_REPLACE_WITH_ADMOB_IOS_INTERSTITIAL_UNIT_ID"
      },
      "monetization": {
        "interstitialSessionLimit": 2,
        "interstitialCooldownMs": 180000
      },
      "cloudSync": {
        "enabled": false
      },
      "eas": {
        "projectId": "c4188d07-e11e-43ce-a21d-5f620933c449"
      }
    }
  }
}
