            "expr": "daily_income * ad_boost_multiplier"
          }
        ]
      },
      {
        "label": "market_crash",
        "when": "random() < crash_chance",
        "updates": [
          {
            "var": "cash",
            "expr": "cash * crash_multiplier"
          }
        ]
      }
    ],
