{
  "runs": 1000,
  "seed": 42,
  "max_steps": 3650,
  "initial_state": {
    "cash": 50000,
    "daily_income": 15000,
    "growth_rate": 0.006,
    "ad_boost_chance": 0.08,
    "ad_boost_multiplier": 1.75
  },
  "step_updates": [
    { "var": "cash", "expr": "cash + daily_income" },
    { "var": "daily_income", "expr": "daily_income * (1 + growth_rate)" }
  ],
  "events": [
    {
      "label": "viral_boost",
      "when": "random() < ad_boost_chance",
      "updates": [
        { "var": "daily_income", "expr": "daily_income * ad_boost_multiplier" }
      ]
    },
    {
      "label": "market_crash",
      "when": "random() < 0.015",
      "updates": [
        { "var": "cash", "expr": "cash * 0.72" }
      ]
    }
  ],
  "milestones": {
    "millionaire": "cash >= 1000000",
    "billionaire": "cash >= 1000000000"
  },
  "stop_condition": "cash >= 1000000000",
  "collect": {
    "final_cash": "cash",
    "final_daily_income": "daily_income"
  }
}
