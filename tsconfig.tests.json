{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true
  },
  "include": [
    "__tests__/**/*",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "app/**/*",
    "coverage/**/*",
    "node_modules/**/*"
  ]
}
